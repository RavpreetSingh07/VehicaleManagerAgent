{
  "expo": {
    "name": "VehicleManager",
    "slug": "VehicleManager",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/vma-logo.png",

    "scheme": "vehiclemanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow VMA to recognize your speech.",
        "NSMicrophoneUsageDescription": "Allow VMA to use your microphone."
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/vma-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.VehicleManager",
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "expo-video",
      "expo-web-browser",

      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow VMA to use your microphone.",
          "speechRecognitionPermission": "Allow VMA to recognize your speech."
        }
      ],

      "expo-notifications"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0ae2cbf-e597-4464-8f6d-d93e288286fd"
      }
    }
  }
}